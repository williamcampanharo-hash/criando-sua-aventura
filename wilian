body {
    background: #1c1c1c;
    color: #f4f4f4;
    font-family: 'Roboto', sans-serif;
}

header {
    background: #007bff;
    padding: 20px;
    text-align: center;
    color: #fff;
}

header h1 {
    font-size: 36px;
}

header p {
    font-size: 18px;
    margin-top: 10px;
}

section {
    margin: 20px;
    padding: 20px;
    background-color: #444;
    border-radius: 8px;
}

section h2 {
    font-size: 28px;
    color: #fff;
}

footer {
    text-align: center;
    padding: 10px;
    background: #333;
    color: #fff;
    margin-top: 40px;
}

/* Estilo para a lista de filmes */
ul {
    list-style-type: none;
    padding: 0;
}

ul li {
    background-color: #555;
    margin: 5px 0;
    padding: 10px;
    border-radius: 5px;
    color: white;
}
